PORT=5055
NODE_ENV=development
API_VERSION=v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=educms_db
DB_USER=postgres
DB_PASSWORD=educms_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_me_too_another_long_random_string
JWT_REFRESH_EXPIRE=30d

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# Optional: leave SMTP_HOST empty to disable emails (they are logged instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@educms.com

BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20

FRONTEND_URL=http://localhost:3001
LOG_LEVEL=info
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
